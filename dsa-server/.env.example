NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB stores users, refresh sessions, conversations, and messages.
MONGODB_URI=mongodb://127.0.0.1:27017/dsa_forge

# Auth secrets: use long random values (32+ bytes) in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Google Gemini
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_NAMESPACE=

# PDF ingestion
PDF_PATH=./files/DSA-revision-guide.pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
INGEST_BATCH_SIZE=50
INGEST_BATCH_DELAY_MS=60000

# Optional operational guardrails
MAX_MESSAGE_LENGTH=8000
RETRIEVAL_TOP_K=8
